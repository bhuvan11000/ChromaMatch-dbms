+  const state = await createRoom(creator, {
+    roomSize: options.roomSize ?? 3,
+    timerSeconds: options.timerSeconds ?? null,
+    attemptsLimit: options.attemptsLimit ?? 3,
+  });
+  roomCodes.push(state.code);
+  return state;
+}
