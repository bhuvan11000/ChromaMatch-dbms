diff --git a/src/lib/db/pg/queries/rooms.ts b/src/lib/db/pg/queries/rooms.ts
index f86f2e2..eae38b6 100644
--- a/src/lib/db/pg/queries/rooms.ts
+++ b/src/lib/db/pg/queries/rooms.ts
@@ -1,7 +1,10 @@
 import { sql } from "drizzle-orm";
 
+import { AppError } from "@/lib/errors";
+
 import { getDb } from "../client";
 import { mapPgError } from "../errors";
+import type { RoomMemberStatus, RoomStatus } from "../functions";
 
 /**
  * Read-only access to `room_scoreboard` — Architecture §5.8.5.
@@ -87,3 +90,178 @@ export async function findRoomScoreboardEntry(
     throw mapPgError(error);
   }
 }
+
+/* ------------------------------------------------------------------ */
+/* Room, membership and colour readers (Architecture §5.7.4 / §5.8)     */
+/* ------------------------------------------------------------------ */
+
+export interface RoomRecord {
+  roomId: number;
+  code: string;
+  creatorId: number;
+  roomSize: number;
+  timerSeconds: 5 | 10 | 15 | null;
+  attemptsLimit: 3 | 5;
+  status: RoomStatus;
+  createdAt: Date;
+  startedAt: Date | null;
+  endedAt: Date | null;
+}
+
+export interface RoomMemberRecord {
+  status: RoomMemberStatus;
+  attemptsUsed: number;
+  bestScore: number | null;
+  joinedAt: Date;
+}
+
+export interface RoomMemberWithUser extends RoomMemberRecord {
+  userId: number;
+  username: string;
+}
+
+export interface RoomColor {
+  h: number;
+  s: number;
+  v: number;
+}
+
+type RoomRow = {
+  room_id: string | number;
+  room_code: string;
+  creator_id: string | number;
+  room_size: string | number;
+  timer_seconds: string | number | null;
+  attempts_limit: string | number;
+  status: string;
+  created_at: Date | string;
+  started_at: Date | string | null;
+  ended_at: Date | string | null;
+};
+
+type MemberRow = {
+  user_id?: string | number;
+  username?: string;
+  status: string;
+  attempts_used: string | number;
+  best_score: string | number | null;
+  joined_at: Date | string;
+};
+
+function optionalDate(value: Date | string | null): Date | null {
+  return value === null ? null : toDate(value);
+}
+
+/** Exact-match lookup; callers normalize the code (trim + upper-case) first. */
+export async function findRoomByCode(code: string): Promise<RoomRecord | null> {
+  try {
+    const rows = await getDb().execute<RoomRow>(sql`
+      select "room_id", "room_code", "creator_id", "room_size", "timer_seconds",
+             "attempts_limit", "status", "created_at", "started_at", "ended_at"
+      from "rooms"
+      where "room_code" = ${code}::text
+    `);
+
+    const row = rows[0];
+    if (!row) return null;
+
+    return {
+      roomId: Number(row.room_id),
+      code: row.room_code,
+      creatorId: Number(row.creator_id),
+      roomSize: Number(row.room_size),
+      timerSeconds: row.timer_seconds === null ? null : (Number(row.timer_seconds) as 5 | 10 | 15),
+      attemptsLimit: Number(row.attempts_limit) as 3 | 5,
+      status: row.status as RoomStatus,
+      createdAt: toDate(row.created_at),
+      startedAt: optionalDate(row.started_at),
+      endedAt: optionalDate(row.ended_at),
+    };
+  } catch (error) {
+    throw mapPgError(error);
+  }
+}
+
+function mapMember(row: MemberRow): RoomMemberRecord {
+  return {
+    status: row.status as RoomMemberStatus,
+    attemptsUsed: Number(row.attempts_used),
+    bestScore: row.best_score === null ? null : Number(row.best_score),
+    joinedAt: toDate(row.joined_at),
+  };
+}
+
+/** One membership row (any status, including `left`), or null. */
+export async function findRoomMember(
+  roomId: number,
+  userId: number,
+): Promise<RoomMemberRecord | null> {
+  try {
+    const rows = await getDb().execute<MemberRow>(sql`
+      select "status", "attempts_used", "best_score", "joined_at"
+      from "room_players"
+      where "room_id" = ${roomId}::bigint
+        and "user_id" = ${userId}::bigint
+    `);
+
+    const row = rows[0];
+    return row ? mapMember(row) : null;
+  } catch (error) {
+    throw mapPgError(error);
+  }
+}
+
+/** Every membership of a room joined with usernames, in join order. */
+export async function listRoomMembers(roomId: number): Promise<RoomMemberWithUser[]> {
+  try {
+    const rows = await getDb().execute<MemberRow>(sql`
+      select rp."user_id", u."username", rp."status", rp."attempts_used",
+             rp."best_score", rp."joined_at"
+      from "room_players" rp
+      join "users" u on u."user_id" = rp."user_id"
+      where rp."room_id" = ${roomId}::bigint
+      order by rp."joined_at" asc, rp."user_id" asc
+    `);
+
+    return rows.map((row) => ({
+      ...mapMember(row),
+      userId: Number(row.user_id),
+      username: row.username ?? "",
+    }));
+  } catch (error) {
+    throw mapPgError(error);
+  }
+}
+
+/** The room's three colours in colour-number order; anything else is a server fault. */
+export async function listRoomColors(roomId: number): Promise<[RoomColor, RoomColor, RoomColor]> {
+  type ColorRow = {
+    hue: string | number;
+    saturation: string | number;
+    value: string | number;
+  };
+  let rows: ColorRow[];
+
+  try {
+    rows = await getDb().execute<ColorRow>(sql`
+      select "hue", "saturation", "value"
+      from "room_colors"
+      where "room_id" = ${roomId}::bigint
+      order by "round_number" asc
+    `);
+  } catch (error) {
+    throw mapPgError(error);
+  }
+
+  if (rows.length !== 3) {
+    throw new AppError("INTERNAL_ERROR", "A started room must have exactly 3 colors.");
+  }
+
+  const colors = rows.map((row): RoomColor => ({
+    h: Number(row.hue),
+    s: Number(row.saturation),
+    v: Number(row.value),
+  }));
+
+  return [colors[0], colors[1], colors[2]];
+}
diff --git a/src/lib/schemas/rooms.ts b/src/lib/schemas/rooms.ts
new file mode 100644
index 0000000..5c1383d
--- /dev/null
+++ b/src/lib/schemas/rooms.ts
@@ -0,0 +1,123 @@
+import { z } from "zod";
+
+import {
+  MAX_GAME_SCORE,
+  ROOM_CODE_ALPHABET,
+  ROOM_CODE_LENGTH,
+  ROOM_MAX_SIZE,
+  ROOM_MIN_SIZE,
+} from "@/lib/config/constants";
+
+/**
+ * Room request/response schemas — Architecture §5.10.6.
+ *
+ * Requests are strict. The same schemas validate the browser forms, the route
+ * bodies and (for responses) the client's parsing of the API envelope.
+ */
+
+const ROOM_CODE_PATTERN = new RegExp(`^[${ROOM_CODE_ALPHABET}]{${ROOM_CODE_LENGTH}}$`);
+
+/** Trims, upper-cases, then requires 8 characters from the room alphabet. */
+export const roomCodeSchema = z
+  .string()
+  .trim()
+  .toUpperCase()
+  .pipe(
+    z
+      .string()
+      .regex(ROOM_CODE_PATTERN, `Room codes are ${ROOM_CODE_LENGTH} characters from the room alphabet.`),
+  );
+
+export const roomTimerSchema = z.union([z.literal(5), z.literal(10), z.literal(15)]).nullable();
+
+export const createRoomRequestSchema = z
+  .object({
+    roomSize: z
+      .number()
+      .int()
+      .min(ROOM_MIN_SIZE, `A room needs at least ${ROOM_MIN_SIZE} players.`)
+      .max(ROOM_MAX_SIZE, `A room holds at most ${ROOM_MAX_SIZE} players.`),
+    timerSeconds: roomTimerSchema,
+    attemptsLimit: z.union([z.literal(3), z.literal(5)]),
+  })
+  .strict();
+
+export type CreateRoomRequest = z.infer<typeof createRoomRequestSchema>;
+
+export const joinRoomRequestSchema = z.object({ code: roomCodeSchema }).strict();
+
+export type JoinRoomRequest = z.infer<typeof joinRoomRequestSchema>;
+
+export const roomStatusSchema = z.enum(["lobby", "in_progress", "finished", "cancelled"]);
+export const roomMemberStatusSchema = z.enum(["active", "finished", "left"]);
+
+const scoreSchema = z.number().finite().min(0).max(MAX_GAME_SCORE);
+
+export const roomMeSchema = z
+  .object({
+    userId: z.number().int().positive(),
+    isCreator: z.boolean(),
+    status: roomMemberStatusSchema,
+    attemptsUsed: z.number().int().nonnegative(),
+    attemptsRemaining: z.number().int().nonnegative(),
+    bestScore: scoreSchema.nullable(),
+  })
+  .strict();
+
+export const roomMemberSchema = z
+  .object({
+    userId: z.number().int().positive(),
+    username: z.string(),
+    isCreator: z.boolean(),
+    status: roomMemberStatusSchema,
+    attemptsUsed: z.number().int().nonnegative(),
+    bestScore: scoreSchema.nullable(),
+    joinedAt: z.iso.datetime(),
+  })
+  .strict();
+
+export const roomStandingSchema = z
+  .object({
+    rank: z.number().int().positive().nullable(),
+    userId: z.number().int().positive(),
+    username: z.string(),
+    bestScore: scoreSchema.nullable(),
+  })
+  .strict();
+
+export const roomStateResponseSchema = z
+  .object({
+    code: z.string(),
+    status: roomStatusSchema,
+    roomSize: z.number().int().positive(),
+    timerSeconds: roomTimerSchema,
+    attemptsLimit: z.union([z.literal(3), z.literal(5)]),
+    creatorId: z.number().int().positive(),
+    createdAt: z.iso.datetime(),
+    startedAt: z.iso.datetime().nullable(),
+    endedAt: z.iso.datetime().nullable(),
+    me: roomMeSchema,
+    members: z.array(roomMemberSchema),
+    standings: z.array(roomStandingSchema).nullable(),
+  })
+  .strict();
+
+export type RoomState = z.infer<typeof roomStateResponseSchema>;
+export type RoomMember = z.infer<typeof roomMemberSchema>;
+export type RoomStanding = z.infer<typeof roomStandingSchema>;
+
+export const ROOM_LEAVE_OUTCOMES = [
+  "left_lobby",
+  "room_cancelled",
+  "left_in_progress",
+  "noop",
+] as const;
+
+export const leaveRoomResponseSchema = z
+  .object({
+    outcome: z.enum(ROOM_LEAVE_OUTCOMES),
+    room: roomStateResponseSchema.nullable(),
+  })
+  .strict();
+
+export type LeaveRoomResponse = z.infer<typeof leaveRoomResponseSchema>;
