# Local Docker services (docker compose up -d)
DATABASE_URL=postgresql://chromamatch:chromamatch@localhost:5432/chromamatch
DATABASE_URL_DIRECT=postgresql://chromamatch:chromamatch@localhost:5432/chromamatch
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chromamatch

# Secrets: replace these dummy values outside local development.
# SESSION_JWT_SECRET and GAME_TOKEN_SECRET must be at least 32 characters and different.
SESSION_JWT_SECRET=dev-only-session-secret-change-me-32chars
GAME_TOKEN_SECRET=dev-only-game-token-secret-change-me-32chars
DAILY_SEED_SECRET=dev-only-daily-seed-change-me-now

APP_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
