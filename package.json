{
  "name": "chromamatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:int": "node -e \"console.log('not implemented yet')\"",
    "test:e2e": "node -e \"console.log('not implemented yet')\"",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom --name",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-achievements.ts",
    "db:seed-admin": "node scripts/seed-admin.ts",
    "mongo:init": "node scripts/init-mongo.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.105.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
