+                <dd className="font-display text-lg font-bold tabular-nums">
+                  {me.attemptsRemaining}
+                </dd>
+              </div>
+              <div>
+                <dt className="font-mono text-[9px] font-bold tracking-[0.14em] text-muted-foreground uppercase">
